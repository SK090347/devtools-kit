    "cli",
    "typescript",
    "developer-tools",
    "uuid",
    "hash",
    "json"
  ],
  "author": "Sumit Kumar Ta",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
