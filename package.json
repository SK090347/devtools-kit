{
  "name": "devtools-kit",
  "version": "1.0.0",
  "description": "Small focused TypeScript CLI toolkit — json-pretty, uuid, hash, serve-headers.",
  "type": "module",
  "bin": {
    "devtools-kit": "./dist/cli.js",
    "dtk": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/cli.ts"
